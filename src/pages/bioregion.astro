---
import BioregionLayout from '../layouts/BioregionLayout.astro';

const inscriptionUrl = 'https://framaforms.org/mooc-session-6-automne-2026-pre-inscription-1765805668';
const siteAdvUrl = 'https://archipelduvivant.org/le-mooc-bioregion/';
const biotopieUrl = 'https://archipelduvivant.org/formation-biotopie/';
const mrMondialisationUrl = 'https://mrmondialisation.org/jean-christophe-anna-revolution-bioregionale/';

const modules = [
  {
    n: '0',
    titre: "D'où partez-vous ?",
    sous: 'Préambule — Questionnaire de prise de conscience',
    desc: "Avant d'entrer dans la biorégion, on commence par vous : votre rapport au monde, au vivant, au territoire que vous habitez. Un questionnaire de prise de conscience pour mesurer d'où vous partez, et voir à la fin du MOOC tout le chemin parcouru.",
    tags: ['Auto-évaluation', 'Ancrage personnel'],
  },
  {
    n: '1',
    titre: 'Utopies : rêvons un peu !',
    sous: 'Module 1',
    desc: "On commence par oser la radicalité de l'imaginaire. Qu'est-ce qu'une société vraiment au service du vivant ? On explore des utopies concrètes, des communautés réelles, des récits qui nous sortent du 'pas possible'. Parce que si on ne se permet pas de rêver, on ne changera rien.",
    tags: ['Utopie', 'Imaginaire', 'Récits'],
  },
  {
    n: '2',
    titre: 'La biorégion, c\'est quoi ?',
    sous: 'Module 2',
    desc: "On pose les fondations. D'où vient l'idée, que désigne-t-elle précisément, en quoi se distingue-t-elle des autres projets écologiques. On démêle le mot, le concept et la pratique. Avec un Dico biorégional pour garder les définitions sous la main.",
    tags: ['Concept', 'Étymologie', 'Dico biorégional'],
  },
  {
    n: '3',
    titre: 'Pourquoi ? Respecter le vivant et les limites planétaires',
    sous: 'Module 3',
    desc: "La biorégion comme réponse systémique à l'effondrement en cours. On descend dans la dureté des enjeux — anéantissement du vivant, civilisation thermo-industrielle, urbanisation de la Terre — et on montre pourquoi l'échelle territoriale est la bonne échelle pour y répondre.",
    tags: ['Limites planétaires', 'Systémique', 'Échelle territoriale'],
  },
  {
    n: '4',
    titre: 'Pourquoi ? Habiter et faire société autrement',
    sous: 'Module 4',
    desc: "La biorégion comme opportunité politique. Sortir des rapports de domination, refonder le démocratique, réinventer l'habiter, le lien, l'autonomie. La biorégion n'est pas qu'écologique : c'est une proposition politique radicale, post-urbaine, libérée des oppressions systémiques.",
    tags: ['Politique', 'Démocratie', 'Oppressions systémiques'],
  },
  {
    n: '5',
    titre: 'Comment la mettre en place ?',
    sous: 'Module 5',
    desc: "On passe à l'action. Concrètement, comment on lance une dynamique biorégionale sur un territoire : avec qui, par où, sur quels leviers. Chaque sous-module se termine par des défis à relever pour poser, chez vous, les premières pierres de l'aventure biorégionale.",
    tags: ['Pratique', 'Défis terrain', 'Mise en œuvre'],
  },
];

const extras = [
  { icon: 'library-big', titre: 'Médiathèque du MOOC', desc: 'Une sélection transversale et riche : livres, podcasts, vidéos, documentaires. Pour creuser chaque filon du biorégionalisme.' },
  { icon: 'video', titre: 'Visios spéciales', desc: 'Écriture d\'un récit utopique avec Futurs Proches, les 4R par Adaptation Radicale, retours d\'expérience d\'ancien·ne·s, écriture d\'un récit biorégional d\'anticipation.' },
  { icon: 'map', titre: 'Carte des Réhabitant·e·s', desc: 'Pour identifier les personnes qui habitent peut-être le même territoire que vous. Le MOOC n\'est pas une formation, c\'est une rencontre.' },
  { icon: 'book-open', titre: 'Dico biorégional', desc: 'Tous les concepts présentés dans le MOOC et leurs définitions, pour ne rien perdre et transmettre à votre tour.' },
  { icon: 'users', titre: 'Visio hebdomadaire', desc: 'Une visio par semaine avec l\'équipe et les participant·e·s. Temps fort d\'échange, de questions, de lien humain réel.' },
  { icon: 'calendar-heart', titre: 'Conclusion & célébration', desc: 'Le MOOC ne se termine pas : il s\'ouvre. On célèbre le chemin parcouru et on bascule vers la Communauté biorégionale.' },
];

const profils = [
  {
    icon: 'trees',
    titre: 'Vous êtes déjà en train de lancer une dynamique biorégionale',
    desc: 'Vous animer une dynamique sur un territoire rural : écolieu, écovillage, coopérative, ferme bio, recyclerie, tiers-lieu, monnaie locale, ZAD... Vous voulez lui donner une dimension plus politique et systémique.',
  },
  {
    icon: 'sparkles',
    titre: 'Vous voulez en impulser une',
    desc: 'Vous sentez l\'appel du territoire. Vous ne savez pas encore par où commencer, ni avec qui. Le MOOC vous donne un cadre, une vision et des premières pierres à poser.',
  },
  {
    icon: 'users-round',
    titre: 'Vous participez à des initiatives alternatives',
    desc: 'Vous êtes engagé·e dans une initiative locale (café associatif, repair café, accorderie, école alternative, MDP, MER...) et vous voulez relier votre engagement à une vision plus large.',
  },
  {
    icon: 'leaf',
    titre: 'Vous êtes en ville, et ça ne vous convient plus',
    desc: 'Vous êtes éveillé·e sur le plan écologique, en milieu urbain. Une envie profonde de changer de vie, de vous reconnecter au vivant, à la Terre, à un territoire. Le MOOC est une porte.',
  },
];

const temoignages = [
  { prenom: 'Maïté', session: 'Session 5', texte: "Tout est top. Les visios permettent de se connecter à d\'autres humains, qui nous sont inconnus mais avec qui on partage déjà des valeurs communes ; de comprendre et constater que nous sommes nombreux à vouloir autre chose ; de construire sa propre réflexion en se nourrissant d\'une part, et en (s\')écoutant d\'autre part. Le simple fait que cela fonctionne de manière presque organique me rassure sur une possibilité de réveil collectif. On a envie d\'y croire !" },
  { prenom: 'Harmonie', session: 'Session 3', texte: "MERCI d\'être là ! J\'ai vraiment vécu ce MOOC comme une transformation. J\'ai plus confiance en moi, j\'assume mieux ma philosophie, mes envies, mes actions. J\'ai rechargé mon espérance aussi ! Avec vous ! Je suis là ! N\'hésitez pas si besoin !" },
  { prenom: 'Sylvaine', session: 'Session 2', texte: "Suivre le MOOC Bioregion a été un moment intense de (re)prise de conscience et une façon actualisée de renouer avec des thématiques qui me sont chères. Malgré la distance numérique et durant les 9 semaines, ce Mooc est très immersif et intense. Les questionnements foisonnent, soutenus par une communauté prête à les accueillir. Le processus est évolutif : il y a un avant et un après. Préparez-vous à un debunkage sans langue de bois, enthousiaste et dans l\'intention de respecter les rythmes du Vivant en nous et autour de nous." },
  { prenom: 'Sidney', session: 'Session 1', texte: "Un grand bravo et une grande reconnaissance à toute l\'équipe pour la gestion en temps réel de ce Mooc. Je vous vois tellement disponibles et réactifs pour répondre de manière attentive et attentionnée à chaque demande, chaque interrogation. Votre posture force le respect. Partant de 0 sur le sujet du biorégionalisme, j\'ai découvert une nouvelle philosophie, un nouveau réseau et me nourris de la multitude de ressources partagées." },
  { prenom: 'Baptiste', session: 'Session 5', texte: "Les contenus sont très riches, vous êtes tous·tes présent·es pour que les participant·es soient relié·es les un·e·s aux autres, c\'est un gros défi. Bravo et merci pour ce voyage dans l\'univers biorégional, ça donne envie de continuer à résister et à construire un autre monde !" },
  { prenom: 'Isabelle', session: 'Session 1', texte: "Bravo, bravo, bravo ! Pour cette bulle d\'oxygène qu\'a été ce Mooc. Et cet espoir d\'un monde plus respectueux du vivant qui s\'ouvre à nous par la possibilité de mise en application concrète qui s\'en dessine. Je me suis sentie longtemps comme une petite île, plus reliée au vivant qu\'aux humains de ce monde capitaliste, et avec ce Mooc j\'ai découvert tout un archipel de personnes qui ont le désir d\'oeuvrer dans le même sens, ensemble." },
  { prenom: 'Laurence', session: 'Session 2', texte: "Ce MOOC est un OVNI. On est embarqué dans une aventure humaine, bouleversante dans tous les sens du terme. Il a bouleversé mes préjugés sur la « formation » qui n\'est pas forcément que passive, mes connaissances sur les modes possibles d\'habiter le vivant, mes projections du futur en me proposant d\'être enfin actrice, ma relation à l\'autre. Enfin, il m\'a aidé à fixer mes priorités qui étaient, au démarrage, trop nombreuses et emmêlées et qui sont désormais plus claires et hiérarchisées. MERCI pour tout !" },
  { prenom: 'Martine', session: 'Session 5', texte: "Je suis extrêmement impressionnée par l\'abondance, la structuration et l\'intelligence de tout ce que vous proposez. Je tiens à vous remercier pour votre précieuse, voire inestimable, contribution à la possibilité de changement de ce monde. Gratitude." },
];

const faqs = [
  { q: 'À qui s\'adresse exactement ce MOOC ?', r: "À quatre profils complémentaires : les personnes qui animent déjà une dynamique biorégionale sur un territoire rural, celles qui veulent en impulser une, les personnes engagées dans des initiatives alternatives locales (écolieux, coopératives, ZAD, monnaies locales, repair cafés...), et les urbain·es éveillé·es qui ressentent l\'appel du territoire et veulent changer de vie." },
  { q: 'Combien de temps ça prend ?', r: "9 semaines, du 26 octobre au 13 décembre 2026. La formule basique représente environ 20 heures au total (contenu des modules + visio hebdomadaire), soit ~2h15/semaine. La formule enrichie (ressources « Pour aller plus loin » + visios spéciales) monte à ~40 heures, soit ~4h30/semaine. Vous choisissez votre rythme." },
  { q: 'C\'est quoi la participation libre et consciente ?', r: "Pas de prix affiché, pas de barrière financière. Vous déterminez vous-même la valeur de votre contribution, en conscience : ce que la formation vaut à vos yeux et ce que vous pouvez donner. C\'est une philosophie radicalement alternative, qui ouvre la formation à toutes et tous et travaille notre rapport collectif à l\'argent." },
  { q: 'Et si je ne peux pas suivre toutes les visios en direct ?', r: "Les visios sont enregistrées et disponibles en replay. La communauté du MOOC reste accessible après la session. L\'important est votre disponibilité globale pendant les 9 semaines pour profiter de l\'expérience collaborative." },
  { q: 'Le MOOC est-il uniquement théorique ?', r: "Non. Chaque module se termine par des défis concrets à relever sur votre territoire pour poser les premières pierres de l\'aventure biorégionale. La radicalité du positionnement est assumée : autonomie, auto-suffisance, autogestion. L\'objectif est d\'impulser une dynamique territoriale réelle, pas seulement de transmettre un concept." },
  { q: 'Et après le MOOC ?', r: "Vous intégrez la Communauté biorégionale, qui réunit les participant·e·s des sessions précédentes et des aventures Biotopie. Pour aller plus loin en immersion opérationnelle, vous pouvez poursuivre avec l\'Aventure Biotopie (stage en présentiel en Centre-Bretagne)." },
];
---

<BioregionLayout
  title="MOOC Biorégion — Comment habiter autrement la Terre — Mathieu Kuntz"
  description="Formation en ligne sur le biorégionalisme, créée par L'Archipel du Vivant. 6e session : automne 2026. Participation libre et consciente. Par Mathieu Kuntz, co-fondateur de l'ONG."
>
  <!-- NAVBAR -->
  <nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#f7f6f1]/85 backdrop-blur-md border-b border-transparent" id="bio-navbar">
    <div class="max-w-screen-2xl mx-auto px-6 md:px-12 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 z-50">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="w-7 h-7 text-[#2d4a2b]">
          <path d="M12 22c-4 0-7-2.5-7-7 0-3.5 2-5 4-7 1.2-1.2 2-3 3-5 1 2 1.8 3.8 3 5 2 2 4 3.5 4 7 0 4.5-3 7-7 7z"/>
          <path d="M12 22V10"/>
          <path d="M12 16c-2 0-3-1-3-3"/>
        </svg>
        <div class="flex flex-col leading-none">
          <span class="text-[10px] tracking-[0.25em] text-[#5c5c5a] uppercase">MOOC</span>
          <span class="text-sm font-display font-medium tracking-wide text-[#1a1f17]">Biorégion</span>
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-8">
        <a href="#concept" class="text-[15px] text-[#1a1f17] hover:text-[#2d4a2b] transition-colors">Le concept</a>
        <a href="#programme" class="text-[15px] text-[#1a1f17] hover:text-[#2d4a2b] transition-colors">Programme</a>
        <a href="#profils" class="text-[15px] text-[#1a1f17] hover:text-[#2d4a2b] transition-colors">Pour qui</a>
        <a href="#temoignages" class="text-[15px] text-[#1a1f17] hover:text-[#2d4a2b] transition-colors">Témoignages</a>
        <a href="#auteur" class="text-[15px] text-[#1a1f17] hover:text-[#2d4a2b] transition-colors">Qui suis-je</a>
        <a href={inscriptionUrl} target="_blank" rel="noopener" class="bg-[#2d4a2b] text-white px-6 py-3 rounded-full text-[15px] font-medium hover:bg-[#3d5a3b] transition-colors flex items-center gap-2">
          Pré-inscription
          <i data-lucide="arrow-up-right" class="w-4 h-4 stroke-[1.8]"></i>
        </a>
      </div>

      <button class="lg:hidden z-50 p-2" id="bio-mobile-menu-btn" aria-label="Menu">
        <i data-lucide="menu" class="w-6 h-6 stroke-[1.5]"></i>
      </button>
    </div>

    <div id="bio-mobile-menu" class="hidden lg:hidden absolute top-full left-0 right-0 bg-[#f7f6f1] border-b border-[#dcdacd] shadow-lg z-40">
      <div class="px-6 py-6 flex flex-col gap-1">
        <a href="#concept" class="py-3.5 px-4 rounded-xl text-base text-[#1a1f17] hover:bg-[#e8e4d9] transition-colors">Le concept</a>
        <a href="#programme" class="py-3.5 px-4 rounded-xl text-base text-[#1a1f17] hover:bg-[#e8e4d9] transition-colors">Programme</a>
        <a href="#profils" class="py-3.5 px-4 rounded-xl text-base text-[#1a1f17] hover:bg-[#e8e4d9] transition-colors">Pour qui</a>
        <a href="#temoignages" class="py-3.5 px-4 rounded-xl text-base text-[#1a1f17] hover:bg-[#e8e4d9] transition-colors">Témoignages</a>
        <a href="#auteur" class="py-3.5 px-4 rounded-xl text-base text-[#1a1f17] hover:bg-[#e8e4d9] transition-colors">Qui suis-je</a>
        <a href={inscriptionUrl} target="_blank" rel="noopener" class="mt-2 py-3.5 px-4 rounded-full bg-[#2d4a2b] text-white text-center font-medium hover:bg-[#3d5a3b] transition-colors">Pré-inscription</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative pt-32 lg:pt-40 pb-24 overflow-hidden">
    <!-- Background decor -->
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute top-[-10%] right-[-15%] w-[60vw] h-[60vw] max-w-[800px] max-h-[800px] rounded-full bg-[#a8b89c]/20 blur-3xl animate-bio-drift"></div>
      <div class="absolute bottom-[-20%] left-[-15%] w-[50vw] h-[50vw] max-w-[700px] max-h-[700px] rounded-full bg-[#c9a96e]/15 blur-3xl animate-bio-float"></div>
    </div>

    <div class="max-w-screen-xl mx-auto px-6 md:px-12">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-3 mb-8">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#2d4a2b]/10 text-[#2d4a2b] text-sm font-medium">
            <span class="w-2 h-2 rounded-full bg-[#2d4a2b] animate-pulse"></span>
            Session 6 — Automne 2026
          </span>
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#c9a96e]/15 text-[#8b6f47] text-sm font-medium">
            Participation libre et consciente
          </span>
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#a8b89c]/20 text-[#2d4a2b] text-sm font-medium">
            9 semaines · 20h à 40h
          </span>
        </div>

        <h1 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] leading-[1.02] tracking-tight text-[#1a1f17] mb-8">
          Biorégion.<br>
          <span class="italic text-[#2d4a2b]">Comment habiter</span><br>
          autrement la Terre.
        </h1>

        <p class="text-lg md:text-xl text-[#3c4239] leading-relaxed max-w-2xl mb-10">
          Une formation en ligne pour explorer l'utopie biorégionale et la rendre concrète. Plonger dans les enjeux de notre époque, comprendre pourquoi la biorégion est une réponse profondément pertinente, et apprendre à la mettre en place, sur votre territoire.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href={inscriptionUrl} target="_blank" rel="noopener" class="inline-flex bg-[#2d4a2b] text-white px-8 py-5 rounded-full items-center justify-center gap-3 hover:bg-[#3d5a3b] transition-all group shadow-lg shadow-[#2d4a2b]/15">
            <span class="text-base font-medium tracking-wide">Je me pré-inscris à la session 6</span>
            <i data-lucide="arrow-right" class="w-5 h-5 stroke-[1.6] group-hover:translate-x-1 transition-transform"></i>
          </a>
          <a href={siteAdvUrl} target="_blank" rel="noopener" class="inline-flex bg-transparent text-[#1a1f17] px-8 py-5 rounded-full items-center justify-center gap-3 hover:bg-[#1a1f17] hover:text-white border border-[#1a1f17]/30 transition-all">
            <span class="text-base font-medium tracking-wide">Voir la page officielle</span>
            <i data-lucide="external-link" class="w-5 h-5 stroke-[1.6]"></i>
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 text-sm text-[#5c5c5a]">
          <div class="flex items-center gap-2">
            <i data-lucide="calendar-days" class="w-4 h-4 stroke-[1.6] text-[#2d4a2b]"></i>
            <span>26 octobre — 13 décembre 2026</span>
          </div>
          <div class="flex items-center gap-2">
            <i data-lucide="video" class="w-4 h-4 stroke-[1.6] text-[#2d4a2b]"></i>
            <span>Visio de présentation : mardi 20 octobre, 12h30 — 14h</span>
          </div>
          <div class="flex items-center gap-2">
            <i data-lucide="users" class="w-4 h-4 stroke-[1.6] text-[#2d4a2b]"></i>
            <span>5 sessions déjà vécues · ~20 anciens dans l'équipe</span>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-2 text-[#5c5c5a]">
      <span class="text-[10px] tracking-[0.3em] uppercase">Descendre</span>
      <i data-lucide="chevron-down" class="w-5 h-5 stroke-[1.5] animate-bounce"></i>
    </div>
  </section>

  <!-- RASSURANCE / RACCROCHE ARCHIPEL DU VIVANT -->
  <section class="py-12 bg-[#1a1f17] text-[#f7f6f1]">
    <div class="max-w-screen-xl mx-auto px-6 md:px-12 flex flex-col md:flex-row items-center justify-center gap-6 text-center md:text-left">
      <div class="flex items-center gap-3">
        <i data-lucide="leaf" class="w-6 h-6 stroke-[1.4] text-[#a8b89c]"></i>
        <span class="font-display text-2xl tracking-wide">Une formation par L'Archipel du Vivant</span>
      </div>
      <span class="hidden md:block text-[#a8b89c]/40">·</span>
      <p class="text-sm md:text-base text-[#dcd9d2] max-w-2xl">
        ONG française de biorégionalisme, fondée en 2019. Basée à l'écovillage Ty Balum, en Centre-Bretagne. Site officiel : <a href="https://archipelduvivant.org" target="_blank" rel="noopener" class="underline underline-offset-4 text-[#a8b89c] hover:text-white transition-colors">archipelduvivant.org</a>.
      </p>
    </div>
  </section>

  <!-- CONCEPT -->
  <section id="concept" class="py-24 lg:py-32">
    <div class="max-w-screen-xl mx-auto px-6 md:px-12">
      <div class="max-w-3xl mb-16">
        <span class="inline-block text-xs tracking-[0.3em] uppercase text-[#2d4a2b] mb-4">Le concept</span>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl leading-[1.05] tracking-tight text-[#1a1f17] mb-8">
          Et s'il fallait <span class="italic text-[#2d4a2b]">penser radicalement</span> différemment ?
        </h2>
        <p class="text-lg md:text-xl text-[#3c4239] leading-relaxed">
          L'époque que nous vivons est singulière à plus d'un titre. Anéantissement du vivant, effondrement de notre civilisation thermo-industrielle, impact délétère des rapports de domination, urbanisation de la Terre, confiscation du pouvoir par une élite. Les défis sont immenses.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-10">
        <div class="bg-[#fdfcf9] rounded-3xl p-8 border border-[#e8e4d9]">
          <div class="w-12 h-12 rounded-2xl bg-[#2d4a2b]/10 flex items-center justify-center mb-6">
            <i data-lucide="circle-help" class="w-6 h-6 stroke-[1.5] text-[#2d4a2b]"></i>
          </div>
          <h3 class="font-display text-2xl text-[#1a1f17] mb-3">Et si changer le système n'était pas possible ?</h3>
          <p class="text-[#3c4239] leading-relaxed">Le système dominant se nourrit de l'extermination du vivant, de l'exploitation des ressources et de l'aliénation des humains. Et s'il fallait cesser de le réformer pour en construire un autre, à une autre échelle ?</p>
        </div>
        <div class="bg-[#fdfcf9] rounded-3xl p-8 border border-[#e8e4d9] md:translate-y-8">
          <div class="w-12 h-12 rounded-2xl bg-[#c9a96e]/15 flex items-center justify-center mb-6">
            <i data-lucide="sparkles" class="w-6 h-6 stroke-[1.5] text-[#8b6f47]"></i>
          </div>
          <h3 class="font-display text-2xl text-[#1a1f17] mb-3">Et si l'utopie était un devoir ?</h3>
          <p class="text-[#3c4239] leading-relaxed">Une société au service du vivant, suffisamment résiliente pour amortir les chocs, libérée des rapports de domination, connectée à la Terre et réellement démocratique. La biorégion est une formidable utopie qui pourrait tout changer.</p>
        </div>
        <div class="bg-[#fdfcf9] rounded-3xl p-8 border border-[#e8e4d9]">
          <div class="w-12 h-12 rounded-2xl bg-[#a8b89c]/25 flex items-center justify-center mb-6">
            <i data-lucide="map-pinned" class="w-6 h-6 stroke-[1.5] text-[#2d4a2b]"></i>
          </div>
          <h3 class="font-display text-2xl text-[#1a1f17] mb-3">Et si la bonne échelle était le territoire ?</h3>
