          <i data-lucide="arrow-right" class="w-6 h-6 stroke-[1.6] group-hover:translate-x-1 transition-transform"></i>
        </a>
        <a href={siteAdvUrl} target="_blank" rel="noopener" class="inline-flex bg-white/5 text-white px-10 py-6 rounded-full items-center justify-center gap-3 hover:bg-white/10 transition-all border border-white/20 font-medium text-lg">
          <span>Page officielle du MOOC</span>
          <i data-lucide="external-link" class="w-5 h-5 stroke-[1.6]"></i>
        </a>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 max-w-3xl mx-auto text-sm">
        <div class="flex items-center justify-center gap-2 text-[#dcd9d2]">
          <i data-lucide="calendar-days" class="w-4 h-4 stroke-[1.6] text-[#a8b89c]"></i>
          <span>26 oct. — 13 déc. 2026</span>
        </div>
        <div class="flex items-center justify-center gap-2 text-[#dcd9d2]">
          <i data-lucide="video" class="w-4 h-4 stroke-[1.6] text-[#a8b89c]"></i>
          <span>Visio : 20 oct. 12h30</span>
        </div>
        <div class="flex items-center justify-center gap-2 text-[#dcd9d2]">
          <i data-lucide="heart-handshake" class="w-4 h-4 stroke-[1.6] text-[#a8b89c]"></i>
          <span>Participation consciente</span>
        </div>
      </div>
    </div>
  </section>

